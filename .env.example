HOST=127.0.0.1
PORT=3005
DATABASE_URL=postgres://reloj:reloj@127.0.0.1:5435/reloj_checador
# Configurar antes de migrar; la conexión activa sigue siendo DATABASE_URL.
NEON_DATABASE_URL=
LOCAL_DATABASE_URL=
PG_CLIENT_IMAGE=postgres:18-alpine
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3005
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=8
ZK_TIMEOUT_MS=10000
ZK_OPERATION_TIMEOUT_MS=120000
ZK_INPORT=5200
SYNC_INTERVAL_SECONDS=60
# node: TCP/IP directo; sdk-bridge: puente Windows opcional basado en el SDK oficial.
ZK_DRIVER=node
ZK_SDK_BRIDGE_URL=http://127.0.0.1:3100
ZK_PHOTO_BRIDGE_URL=http://127.0.0.1:3200

# Activar después de configurar el remitente de WhatsApp y las URLs HTTPS públicas.
TWILIO_WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
PUBLIC_API_URL=
# Opcionales si PUBLIC_API_URL incluye la base y el prefijo del proxy correctos.
TWILIO_INCOMING_WEBHOOK_URL=
TWILIO_STATUS_CALLBACK_URL=
PHONE_DEFAULT_COUNTRY=MX
# Mapa: clave -> {"contentSid":"HX...","variables":["employeeName","requestReference"]}
TWILIO_WHATSAPP_TEMPLATES={}
