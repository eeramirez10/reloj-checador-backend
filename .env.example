HOST=127.0.0.1
PORT=3005
DATABASE_URL=postgres://reloj:reloj@127.0.0.1:5435/reloj_checador
ZK_TIMEOUT_MS=10000
ZK_INPORT=5200
SYNC_INTERVAL_SECONDS=60
