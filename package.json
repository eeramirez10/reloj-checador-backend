{
  "name": "reloj-checador-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "postinstall": "node scripts/patch-zklib.mjs && prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "tsx scripts/test-integration.ts",
    "verify:baseline": "tsx scripts/verify-prisma-baseline.ts",
    "verify:data": "tsx scripts/verify-refactor-data.ts",
    "verify:employee-cards": "tsx scripts/verify-employee-card-bindings.ts",
    "migrate": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:status": "prisma migrate status",
    "prisma:baseline": "prisma migrate resolve --applied 00000000000000_baseline",
    "import:employees": "tsx scripts/import-employee-catalog.ts",
    "import:employee-cards": "tsx scripts/import-employee-cards.ts",
    "backup:database": "tsx scripts/backup-database.ts",
    "auth:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "db:migrate-neon": "tsx scripts/migrate-neon.ts",
    "db:activate-neon": "tsx scripts/activate-neon.ts"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@noble/hashes": "2.4.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "cookie": "1.0.2",
    "dotenv": "^16.6.1",
    "fastify": "^5.3.2",
    "libphonenumber-js": "1.13.10",
    "node-zklib": "^1.3.0",
    "pg": "^8.16.3",
    "twilio": "5.13.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "@types/pg": "^8.15.4",
    "prisma": "7.9.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
