generator client {
  provider        = "prisma-client"
  output          = "../src/infrastructure/database/generated"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model attendance_deductions {
  id                   String               @id @db.Uuid
  subject_id           String               @db.Uuid
  policy_id            String               @db.Uuid
  trigger_incident_id  String               @unique @db.Uuid
  category             String
  window_start         DateTime             @db.Date
  window_end           DateTime             @db.Date
  incident_ids         String[]             @db.Uuid
  salary_days          Int                  @default(1)
  voided_at            DateTime?            @db.Timestamptz(6)
  created_at           DateTime             @default(now()) @db.Timestamptz(6)
  branch_policies      branch_policies      @relation(fields: [policy_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attendance_incidents attendance_incidents @relation(fields: [trigger_incident_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model attendance_evaluations {
  id                   String                 @id @db.Uuid
  subject_id           String                 @db.Uuid
  employee_id          String?                @db.Uuid
  device_user_id       String?                @db.Uuid
  date                 DateTime               @db.Date
  branch_id            String?                @db.Uuid
  schedule_id          String?                @db.Uuid
  policy_id            String?                @db.Uuid
  result               Json
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  active               Boolean                @default(true)
  branches             branches?              @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  device_users         device_users?          @relation(fields: [device_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees            employees?             @relation(fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch_policies      branch_policies?       @relation(fields: [policy_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  work_schedules       work_schedules?        @relation(fields: [schedule_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attendance_incidents attendance_incidents[]

  @@unique([subject_id, date])
  @@index([branch_id, date], map: "attendance_evaluations_branch_date_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model attendance_incidents {
  id                     String                 @id @db.Uuid
