  employee_clock_events_employee_clock_events_device_user_idTodevice_users          employee_clock_events[]  @relation("employee_clock_events_device_user_idTodevice_users")
  employee_clock_events_employee_clock_events_previous_device_user_idTodevice_users employee_clock_events[]  @relation("employee_clock_events_previous_device_user_idTodevice_users")
  schedule_assignments                                                              schedule_assignments[]

  @@unique([device_id, device_user_id])
  @@index([device_id, name], map: "device_users_device_name_idx")
