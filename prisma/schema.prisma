generator client {
  provider        = "prisma-client"
  output          = "../src/infrastructure/database/generated"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model attendance_deductions {
  id                   String               @id @db.Uuid
  subject_id           String               @db.Uuid
  policy_id            String               @db.Uuid
  trigger_incident_id  String               @unique @db.Uuid
  category             String
  window_start         DateTime             @db.Date
  window_end           DateTime             @db.Date
  incident_ids         String[]             @db.Uuid
  salary_days          Int                  @default(1)
  voided_at            DateTime?            @db.Timestamptz(6)
  created_at           DateTime             @default(now()) @db.Timestamptz(6)
  branch_policies      branch_policies      @relation(fields: [policy_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attendance_incidents attendance_incidents @relation(fields: [trigger_incident_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model attendance_evaluations {
  id                   String                 @id @db.Uuid
  subject_id           String                 @db.Uuid
  employee_id          String?                @db.Uuid
  device_user_id       String?                @db.Uuid
  date                 DateTime               @db.Date
  branch_id            String?                @db.Uuid
  schedule_id          String?                @db.Uuid
  policy_id            String?                @db.Uuid
  result               Json
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  active               Boolean                @default(true)
  branches             branches?              @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  device_users         device_users?          @relation(fields: [device_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees            employees?             @relation(fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch_policies      branch_policies?       @relation(fields: [policy_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  work_schedules       work_schedules?        @relation(fields: [schedule_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attendance_incidents attendance_incidents[]

  @@unique([subject_id, date])
  @@index([branch_id, date], map: "attendance_evaluations_branch_date_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model attendance_incidents {
  id                     String                 @id @db.Uuid
  evaluation_id          String                 @db.Uuid
  subject_id             String                 @db.Uuid
  policy_id              String                 @db.Uuid
  log_id                 String                 @db.Uuid
  kind                   String
  occurred_at            DateTime               @db.Timestamptz(6)
  minutes                Int
  active                 Boolean                @default(true)
  attendance_deductions  attendance_deductions?
  attendance_evaluations attendance_evaluations @relation(fields: [evaluation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attendance_logs        attendance_logs        @relation(fields: [log_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch_policies        branch_policies        @relation(fields: [policy_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([evaluation_id, kind])
  @@index([subject_id, occurred_at], map: "attendance_incidents_subject_idx")
}

model attendance_logs {
  id                   String                 @id @db.Uuid
  device_id            String                 @db.Uuid
  event_key            String
  device_log_id        String?
  user_id              String
  verification_type    Int?
  punch_state          Int?
  occurred_at          DateTime               @db.Timestamptz(6)
  raw_data             Json
  received_at          DateTime               @default(now()) @db.Timestamptz(6)
  branch_id            String?                @db.Uuid
  attendance_incidents attendance_incidents[]
  branches             branches?              @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  devices              devices                @relation(fields: [device_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([device_id, event_key])
  @@index([device_id, occurred_at(sort: Desc)], map: "attendance_logs_device_occurred_at_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model branch_assignments {
  id             String        @id @db.Uuid
  employee_id    String?       @db.Uuid
  device_user_id String?       @db.Uuid
  device_id      String?       @db.Uuid
  branch_id      String        @db.Uuid
  effective_from DateTime      @db.Date
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  branches       branches      @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  devices        devices?      @relation(fields: [device_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  device_users   device_users? @relation(fields: [device_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees      employees?    @relation(fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([device_id, effective_from], map: "branch_assignments_device_date_idx")
  @@unique([employee_id, effective_from], map: "branch_assignments_employee_date_idx")
  @@unique([device_user_id, effective_from], map: "branch_assignments_user_date_idx")
